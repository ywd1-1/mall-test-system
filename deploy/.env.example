# Copy this file to .env and fill every empty password before deployment.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=mall_app
MYSQL_PASSWORD=
ADMIN_PASSWORD=

# These ports bind MySQL, the backend, and the frontend container to the server itself.
# The host Nginx should proxy public traffic to HTTP_PORT.
MYSQL_PORT=3306
BACKEND_PORT=8080
HTTP_PORT=8081
