          "name": "查询第一页在售商品",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "\r",
                  "pm.test(\"商品列表查询成功\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "    pm.expect(res.code).to.eql(200);\r",
                  "    pm.expect(res.data.records).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"列表只包含在售商品\", function () {\r",
                  "    const allOnSale = res.data.records.every(function (product) {\r",
                  "        return product.status === \"ON_SALE\";\r",
                  "    });\r",
                  "    pm.expect(allOnSale).to.be.true;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
