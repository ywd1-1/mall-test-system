      "name": "登录与注册",
      "item": [
        {
          "name": "使用正确账号密码登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 检查状态码\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "//检查整体body\r",
                  "//pm.test(\"body中有没有包含这个数据\", function () {\r",
                  "//    pm.response.to.have.body(message);\r",
                  "//});\r",
                  "// 检查响应当中是否包含该字符\r",
                  "pm.test(\"检查响应是否包含这个数据\", function () {\r",
                  "    pm.expect(pm.response.text()).to.include(\"success\");\r",
                  "});\r",
                  "// 检查对应字段对不对\r",
                  "//pm.test(\"检查对应字段对不对\", function () {\r",
                  "    //var jsonData = pm.response.json();\r",
                  "   //pm.expect(jsonData.code).to.eql(200);\r",
                  "   //多层次需要一层一层访问\r",
                  "   //pm.expect(jsonData.data.user.id).to.eql(4);\r",
                  "//});\r",
                  "\r",
                  "const res = pm.response.json();\r",
                  "\r",
                  "pm.test(\"HTTP状态码为200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"管理员登录成功\", function () {\r",
                  "    pm.expect(res.code).to.eql(200);\r",
                  "    pm.expect(res.data.token).to.be.a(\"string\").and.not.empty;\r",
                  "    pm.expect(res.data.user.username).to.eql(\"admin\");\r",
                  "    pm.expect(res.data.user.role).to.eql(\"ADMIN\");\r",
                  "});\r",
                  "\r",
                  "if (res.code === 200 && res.data && res.data.token) {\r",
                  "    pm.environment.set(\"atoken\", res.data.token);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\":\"admin\",\r\n    \"password\":\"123456\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{url}}/api/login",
              "host": [
                "{{url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          },
          "response": []
        },
